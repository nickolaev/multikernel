From 7a4696767f30e6dc63fd01c4c753145e7642f71a Mon Sep 17 00:00:00 2001
From: Nikolay Nikolaev <nicknickolaev@gmail.com>
Date: Thu, 16 Jul 2026 08:47:38 +0300
Subject: [PATCH 4/4] x86/multikernel: keep LAPIC timer in spawned kernels

---
 arch/x86/kernel/apic/apic.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/arch/x86/kernel/apic/apic.c b/arch/x86/kernel/apic/apic.c
index d93f87f29d03..4091d3069401 100644
--- a/arch/x86/kernel/apic/apic.c
+++ b/arch/x86/kernel/apic/apic.c
@@ -67,6 +67,7 @@
 #include <asm/intel-family.h>
 #include <asm/irq_regs.h>
 #include <asm/cpu.h>
+#include <asm/setup.h>
 
 #include "local.h"
 
@@ -923,7 +924,8 @@ static int __init calibrate_APIC_clock(void)
 	 * timer based calibration, if a global clockevent device is
 	 * available.
 	 */
-	if (!pm_referenced && global_clock_event) {
+	if (!pm_referenced && global_clock_event &&
+	    boot_params.hdr.hardware_subarch != X86_SUBARCH_MULTIKERNEL) {
 		apic_pr_verbose("... verify APIC timer\n");
 
 		/*
@@ -953,6 +955,15 @@ static int __init calibrate_APIC_clock(void)
 		else
 			levt->features |= CLOCK_EVT_FEAT_DUMMY;
 	}
+	/*
+	 * A spawned kernel does not own the platform timer interrupt used by
+	 * the verification above. The LAPIC was calibrated against the TSC,
+	 * so keep it as the per-CPU clock event instead of rejecting it because
+	 * jiffies from the primary kernel's timer cannot advance here.
+	 */
+	if (!pm_referenced && global_clock_event &&
+	    boot_params.hdr.hardware_subarch == X86_SUBARCH_MULTIKERNEL)
+		pr_info("APIC timer: skipping legacy timer verification for multikernel\n");
 	local_irq_enable();
 
 	if (levt->features & CLOCK_EVT_FEAT_DUMMY) {
