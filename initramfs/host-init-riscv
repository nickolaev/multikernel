#!/bin/sh

PATH=/bin:/sbin
PYTHONHOME=/usr
PYTHONPATH=/usr/lib/python3/dist-packages
PYTHONDONTWRITEBYTECODE=1
export PATH
export PYTHONHOME PYTHONPATH PYTHONDONTWRITEBYTECODE

kerf()
{
	/usr/bin/python3 -m kerf.cli "$@"
}

fail()
{
	printf 'MK_DEMO_FAIL stage=%s\n' "$1"
	sync
	poweroff -f
	while :; do sleep 1; done
}

expect_status()
{
	expected=$1
	status_file=/sys/fs/multikernel/instances/qemu-demo/status
	attempt=0
	while [ "$attempt" -lt 50 ]; do
		actual=$(cat "$status_file" 2>/dev/null || true)
		if [ "$actual" = "$expected" ]; then
			printf 'MK_STAGE_STATUS_%s id=1\n' "$expected"
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	printf 'MK_STATUS_MISMATCH expected=%s actual=%s\n' "$expected" "$actual"
	return 1
}

wait_secondary()
{
	cycle=$1
	marker_file="/mktty-success-$cycle"
	rm -f "$marker_file"
	while IFS= read -r line; do
		printf 'MK_SECONDARY_STREAM:%s\n' "$line"
		case "$line" in
			*MK_SECONDARY_ALIVE*) touch "$marker_file"; break ;;
		esac
	done <&3 &
	reader_pid=$!
	attempt=0
	while [ "$attempt" -lt 600 ] && [ ! -e "$marker_file" ]; do
		attempt=$((attempt + 1))
		sleep 1
	done
	kill "$reader_pid" 2>/dev/null || true
	if [ ! -e "$marker_file" ]; then
		printf '<6>MK_DIAG_BOOT:%s\n' \
			"$(cat /sys/fs/multikernel/instances/qemu-demo/boot 2>/dev/null || true)" >/dev/kmsg
		while IFS= read -r line; do
			printf '<6>MK_DIAG_IPI:%s\n' "$line" >/dev/kmsg
		done </sys/fs/multikernel/instances/qemu-demo/ipi
		fail "secondary-marker-$cycle"
	fi
	printf 'MK_STAGE_SECONDARY_ALIVE cycle=%s\n' "$cycle"
}

mount -t proc proc /proc || fail mount-proc
mount -t sysfs sysfs /sys || fail mount-sysfs
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

grep -q 'Multikernel Memory Pool' /proc/iomem || fail pool-reservation
printf 'MK_STAGE_POOL_OK size=512M base=0xc0000000\n'

boot_line=$(/bin/busybox dmesg | /bin/busybox grep -m1 '^Booting Linux on hartid ')
boot_hart=${boot_line##* }
guest_hart=
for candidate in 0 1 2 3; do
	if [ "$candidate" != "$boot_hart" ]; then
		guest_hart=$candidate
		break
	fi
done
[ -n "$guest_hart" ] || fail guest-hart-selection
printf 'MK_STAGE_HART_SELECTED boot=%s guest=%s\n' "$boot_hart" "$guest_hart"

kerf init --cpus="$guest_hart" || fail kerf-init
printf 'MK_STAGE_KERF_INIT_OK cpu=%s memory=512M\n' "$guest_hart"
kerf create qemu-demo --id=1 --cpus="$guest_hart" --memory=256MB \
	--memory-base=0xc0000000 || fail kerf-create
printf 'MK_STAGE_KERF_CREATE_OK id=1\n'
expect_status ready || fail status-ready

kerf load qemu-demo --kernel=/payload/vmlinux \
	--initrd=/payload/secondary-initrd.cpio.gz \
	--cmdline='rdinit=/init panic=-1 kho=on nr_cpus=1' \
	--console=mktty0 || fail kerf-load
printf 'MK_STAGE_KERF_LOAD_OK id=1\n'
expect_status loaded || fail status-loaded

exec 3<>/dev/mktty || fail mktty-open
printf '1\n' >&3 || fail mktty-select
printf 'MK_STAGE_MKTTY_CONNECTED id=1\n'

kerf exec qemu-demo || fail kerf-exec
printf 'MK_STAGE_KERF_EXEC_OK id=1\n'
expect_status active || fail status-active

wait_secondary 0

if kerf kill --force qemu-demo >/tmp/force-halt.log 2>&1; then
	cat /tmp/force-halt.log
	fail force-halt-unexpected-success
fi
cat /tmp/force-halt.log
expect_status active || fail force-halt-state
printf 'MK_STAGE_FORCE_HALT_UNSUPPORTED id=1\n'

for cycle in 1 2; do
	kerf kill qemu-demo || fail "graceful-halt-$cycle"
	expect_status loaded || fail "status-loaded-$cycle"
	printf 'MK_STAGE_GRACEFUL_HALT_OK cycle=%s\n' "$cycle"

	kerf exec qemu-demo || fail "respawn-$cycle"
	expect_status active || fail "status-active-$cycle"
	wait_secondary "$cycle"
	printf 'MK_STAGE_RESPAWN_OK cycle=%s\n' "$cycle"
done

actual=$(cat /sys/fs/multikernel/instances/qemu-demo/status 2>/dev/null || true)
[ "$actual" = active ] || fail status-active-after-wait
printf '<6>MK_PRIMARY_STILL_ALIVE instance=0 secondary_status=%s respawns=2\n' "$actual" >/dev/kmsg
sync
poweroff -f
while :; do sleep 1; done
