#!/bin/sh

PATH=/bin:/sbin
export PATH

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

for attempt in 1 2 3 4 5; do
	if [ -c /dev/mktty0 ]; then
		printf 'MK_SECONDARY_ALIVE instance=1 pid=%s\n' "$$" >/dev/mktty0
		break
	fi
	sleep 1
done

if [ ! -c /dev/mktty0 ]; then
	printf 'MK_SECONDARY_FAIL missing=/dev/mktty0\n' >/dev/console
fi

while :; do
	sleep 3600
done
