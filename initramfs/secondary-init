#!/bin/sh

PATH=/bin:/sbin
PYTHONHOME=/usr
PYTHONPATH=/usr/lib/python3/dist-packages
PYTHONDONTWRITEBYTECODE=1
export PATH
export PYTHONHOME PYTHONPATH PYTHONDONTWRITEBYTECODE

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

/usr/bin/python3 -S -m harness.secondary
status=$?
printf 'MK_SECONDARY_FAIL reason=python-exit status=%s\n' "${status}" >/dev/console
sync
poweroff -f
while :; do sleep 1; done
