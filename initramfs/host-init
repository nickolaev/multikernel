#!/bin/sh

PATH=/bin:/sbin
PYTHONHOME=/usr
PYTHONPATH=/usr/lib/python3/dist-packages
PYTHONDONTWRITEBYTECODE=1
export PATH
export PYTHONHOME PYTHONPATH PYTHONDONTWRITEBYTECODE

kerf()
{
	/usr/bin/python3 -m kerf.cli "$@"
}

fail()
{
	printf 'MK_DEMO_FAIL stage=%s\n' "$1"
	sync
	poweroff -f
	while :; do sleep 1; done
}

driver_name()
{
	driver_link=$(/bin/busybox readlink "$1/driver" 2>/dev/null || true)
	printf '%s' "${driver_link##*/}"
}

expect_status()
{
	instance_name=$1
	instance_id=$2
	expected=$3
	status_file=/sys/fs/multikernel/instances/$instance_name/status
	attempt=0
	actual=
	while [ "$attempt" -lt 50 ]; do
		actual=$(cat "$status_file" 2>/dev/null || true)
		if [ "$actual" = "$expected" ]; then
			printf 'MK_STAGE_STATUS_%s name=%s id=%s\n' \
				"$expected" "$instance_name" "$instance_id"
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	printf 'MK_STATUS_MISMATCH name=%s id=%s expected=%s actual=%s\n' \
		"$instance_name" "$instance_id" "$expected" "$actual"
	return 1
}

assert_pf_owned()
{
	phase=$1
	pf_driver=$(driver_name "$pf_path")
	[ "$pf_driver" = igb ] || fail "pf-driver-$phase"
	[ "$(cat "$pf_path/sriov_numvfs")" = 1 ] || fail "vf-count-$phase"
	/bin/busybox ip link show "$pf_netdev" | grep -q 'UP' \
		|| fail "pf-link-$phase"
}

assert_vf_owner()
{
	expected_driver=$1
	phase=$2
	vf_driver=$(driver_name "$vf_path")
	[ "$vf_driver" = "$expected_driver" ] || fail "vf-owner-$phase"
	assert_pf_owned "$phase"
}

expect_create_rejected()
{
	stage=$1
	instance_name=$2
	instance_id=$3
	cpu_id=$4
	memory=$5
	devices=$6
	expected_driver=$7
	log_file=/run/$stage.log

	if kerf create "$instance_name" --id="$instance_id" --cpus="$cpu_id" \
		--memory="$memory" --devices="$devices" >"$log_file" 2>&1; then
		/bin/busybox cat "$log_file"
		fail "$stage-accepted"
	fi
	[ ! -e "/sys/fs/multikernel/instances/$instance_name" ] \
		|| fail "$stage-instance-leaked"
	assert_vf_owner "$expected_driver" "$stage"
	printf 'MK_HOSTILE_CREATE_REJECTED stage=%s name=%s id=%s devices=%s vf_driver=%s rollback=clean\n' \
		"$stage" "$instance_name" "$instance_id" "$devices" "$expected_driver"
}

hostile_lease_attempts()
{
	lease_phase=$1

	if printf '0\n' >"$pf_path/sriov_numvfs" 2>/run/disable-vfs-$lease_phase.log; then
		fail "disable-vfs-$lease_phase-accepted"
	fi
	assert_vf_owner multikernel-pci-assignment "disable-vfs-$lease_phase"
	printf 'MK_HOSTILE_VF_DISABLE_REJECTED phase=%s pf=%s vfs=1\n' \
		"$lease_phase" "$pf_bdf"

	if printf '%s\n' "$vf_bdf" \
		>/sys/bus/pci/drivers/igbvf/bind 2>/run/rebind-vf-$lease_phase.log; then
		fail "rebind-vf-$lease_phase-accepted"
	fi
	assert_vf_owner multikernel-pci-assignment "rebind-vf-$lease_phase"
	printf 'MK_HOSTILE_VF_REBIND_REJECTED phase=%s vf=%s owner=multikernel-pci-assignment\n' \
		"$lease_phase" "$vf_bdf"

	printf '%s\n' "$vf_bdf" >/sys/bus/pci/drivers_probe \
		|| fail "reprobe-vf-$lease_phase-write"
	assert_vf_owner multikernel-pci-assignment "reprobe-vf-$lease_phase"
	printf 'MK_HOSTILE_VF_REPROBE_CONTAINED phase=%s vf=%s owner=multikernel-pci-assignment\n' \
		"$lease_phase" "$vf_bdf"

	if printf '%s\n' "$pf_bdf" \
		>/sys/bus/pci/drivers/multikernel-pci-assignment/bind \
		2>/run/bind-pf-$lease_phase.log; then
		fail "bind-pf-$lease_phase-accepted"
	fi
	assert_vf_owner multikernel-pci-assignment "bind-pf-$lease_phase"
	printf 'MK_HOSTILE_PF_BIND_REJECTED phase=%s pf=%s driver=igb\n' \
		"$lease_phase" "$pf_bdf"
}

wait_vf_owner()
{
	expected_driver=$1
	attempt=0
	while [ "$attempt" -lt 50 ]; do
		vf_driver=$(driver_name "$vf_path")
		[ "$vf_driver" = "$expected_driver" ] && return 0
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

mount -t proc proc /proc || fail mount-proc
mount -t sysfs sysfs /sys || fail mount-sysfs
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
/bin/busybox insmod /lib/modules/lazy_cma.ko || fail lazy-cma-module
pool_output=$(/bin/lazy_cma_tool -a 512 -n 'Multikernel Memory Pool') \
	|| fail pool-allocation
pool_base=${pool_output##* }
case "$pool_base" in
	0x[0-9a-fA-F]*) ;;
	*) fail pool-address ;;
esac

pf_bdf=0000:00:02.0
pf_path=/sys/bus/pci/devices/$pf_bdf
pf_netdev=
for net_path in "$pf_path"/net/*; do
	[ -e "$net_path" ] || continue
	pf_netdev=${net_path##*/}
	break
done
[ -n "$pf_netdev" ] || fail pf-netdev
/bin/busybox ip link set "$pf_netdev" up || fail pf-link-up
/bin/busybox ip addr add 10.0.2.14/24 dev "$pf_netdev" || fail pf-address
printf 'MK_STAGE_PF_LINK_UP pf=%s netdev=%s\n' "$pf_bdf" "$pf_netdev"
printf 'MK_STAGE_PF_ADDRESS pf=%s netdev=%s address=10.0.2.14/24\n' "$pf_bdf" "$pf_netdev"
sleep 2
[ -e "$pf_path/sriov_numvfs" ] || fail vf-missing-sriov
printf '1\n' >"$pf_path/sriov_numvfs" || fail vf-enable

attempt=0
vf_path=
while [ "$attempt" -lt 50 ]; do
	vf_path=$(/bin/busybox readlink -f "$pf_path/virtfn0" 2>/dev/null || true)
	[ -n "$vf_path" ] && [ -e "$vf_path/vendor" ] && break
	attempt=$((attempt + 1))
	sleep 1
done
[ -n "$vf_path" ] && [ -e "$vf_path/vendor" ] || fail vf-discovery

vf_bdf=${vf_path##*/}
vf_vendor=$(cat "$vf_path/vendor")
vf_device=$(cat "$vf_path/device")
vf_vendor=${vf_vendor#0x}
vf_device=${vf_device#0x}
pf_vendor=$(cat "$pf_path/vendor")
pf_device=$(cat "$pf_path/device")
pf_vendor=${pf_vendor#0x}
pf_device=${pf_device#0x}
/bin/busybox sed \
	-e "s/@MEMORY_BASE@/$pool_base/g" \
	-e "s/@PF_BDF@/$pf_bdf/g" \
	-e "s/@PF_VENDOR@/$pf_vendor/g" \
	-e "s/@PF_DEVICE@/$pf_device/g" \
	-e "s/@VF_BDF@/$vf_bdf/g" \
	-e "s/@VF_VENDOR@/$vf_vendor/g" \
	-e "s/@VF_DEVICE@/$vf_device/g" \
	/assets/baseline.dts > /run/baseline.dts || fail vf-baseline
printf 'MK_STAGE_VF_CREATED pf=%s vf=%s vendor=%s device=%s\n' \
	"$pf_bdf" "$vf_bdf" "$vf_vendor" "$vf_device"

attempt=0
vf_host_driver=
while [ "$attempt" -lt 50 ]; do
	vf_host_driver=$(driver_name "$vf_path")
	[ -n "$vf_host_driver" ] && break
	attempt=$((attempt + 1))
	sleep 1
done
[ "$vf_host_driver" = igbvf ] || fail vf-host-driver
vf_group_path=$(/bin/busybox readlink -f "$vf_path/iommu_group" 2>/dev/null || true)
[ -n "$vf_group_path" ] && [ -d "$vf_group_path" ] || fail vf-iommu-group
vf_group=${vf_group_path##*/}
group_members=0
group_member=
for group_device in "$vf_group_path"/devices/*; do
	[ -e "$group_device" ] || continue
	group_members=$((group_members + 1))
	group_member=${group_device##*/}
done
[ "$group_members" -eq 1 ] && [ "$group_member" = "$vf_bdf" ] \
	|| fail vf-iommu-group-not-singleton
dmesg | grep -Fq 'DMAR: IOMMU enabled' || fail iommu-not-enabled
dmesg | grep -Fq 'DMAR-IR: Enabled IRQ remapping' || fail irq-remapping-not-enabled
printf 'MK_STAGE_IOMMU_ENABLED driver=intel_iommu strict=1 intremap=on\n'
printf 'MK_STAGE_IOMMU_GROUP vf=%s group=%s members=1\n' "$vf_bdf" "$vf_group"

kerf init --input=/run/baseline.dts || fail kerf-init
grep -q 'Multikernel Memory Pool' /proc/iomem || fail pool-handoff
printf 'MK_STAGE_POOL_OK size=512M base=%s\n' "$pool_base"
assert_vf_owner "$vf_host_driver" baseline
printf 'MK_STAGE_PF_RETAINED pf=%s driver=igb\n' "$pf_bdf"
printf 'MK_STAGE_VF_HOST_OWNED vf=%s driver=%s phase=baseline\n' \
	"$vf_bdf" "$vf_host_driver"
printf 'MK_STAGE_KERF_INIT_OK cpus=2,3 memory=512M\n'
expect_create_rejected pf-assignment hostile-pf 101 2 64MB igbpf0 igbvf
dmesg | grep -Fq "PCI assignment only supports SR-IOV VFs, rejecting $pf_bdf" \
	|| fail pf-rejection-not-kernel-enforced
expect_create_rejected duplicate-vf hostile-duplicate 102 2 64MB \
	igbvf0,igbvf0 igbvf
kerf create qemu-demo --id=1 --cpus=2 --memory=256MB \
	--memory-base="$pool_base" --devices=igbvf0 || fail kerf-create
printf 'MK_STAGE_KERF_CREATE_OK id=1\n'
expect_status qemu-demo 1 ready || fail status-ready
pf_driver=$(driver_name "$pf_path")
[ "$pf_driver" = igb ] || fail pf-driver-lost-during-assignment
vf_driver=$(driver_name "$vf_path")
[ "$vf_driver" = multikernel-pci-assignment ] || fail vf-assignment-driver
dmesg | grep -Fq "Prepared host IOMMU domain for $vf_bdf with 1 instance regions" \
	|| fail vf-iommu-domain-prepare
dmesg | grep -Fq "Attached $vf_bdf to host-owned IOMMU domain for instance 1" \
	|| fail vf-iommu-domain-attach
printf 'MK_STAGE_VF_LEASED id=1 vf=%s driver=%s host_driver=%s\n' \
	"$vf_bdf" "$vf_driver" "$vf_host_driver"
printf 'MK_STAGE_IOMMU_DOMAIN id=1 vf=%s group=%s mapped_regions=1 owner=host\n' \
	"$vf_bdf" "$vf_group"
expect_create_rejected second-owner hostile-owner 103 3 128MB \
	igbvf0 multikernel-pci-assignment
hostile_lease_attempts ready
grep -q 'pci-host-bridges' /sys/fs/multikernel/instances/qemu-demo/device_tree \
	|| fail pci-host-bridge-instance-dtb
printf 'MK_STAGE_PCI_HOST_BRIDGE_METADATA id=1 segment=0000 buses=00-ff ecam=0xb0000000\n'
grep -q "$vf_bdf" /sys/fs/multikernel/instances/qemu-demo/device_tree \
	|| fail vf-instance-dtb
printf 'MK_STAGE_VF_ASSIGNED id=1 vf=%s resource=igbvf0\n' "$vf_bdf"

kerf load qemu-demo --kernel=/payload/vmlinux \
	--initrd=/payload/secondary-initrd.cpio.gz \
	--cmdline="rdinit=/init quiet loglevel=6 panic=-1 kho=on mk_vf_bdf=$vf_bdf" \
	--console=mktty0 || fail kerf-load
printf 'MK_STAGE_KERF_LOAD_OK id=1\n'
expect_status qemu-demo 1 loaded || fail status-loaded

exec 3<>/dev/mktty || fail mktty-open
printf '1\n' >&3 || fail mktty-select
printf 'MK_STAGE_MKTTY_CONNECTED id=1\n'

kerf exec qemu-demo || fail kerf-exec
printf 'MK_STAGE_KERF_EXEC_OK id=1\n'
expect_status qemu-demo 1 active || fail status-active

if ! timeout 90 sh -c '
	while IFS= read -r line; do
		printf "MK_SECONDARY_STREAM:%s\n" "$line"
		case "$line" in
			*MK_SECONDARY_ALIVE*) exit 0 ;;
		esac
	done <&3
	exit 1
'; then
	secondary_status=$(cat /sys/fs/multikernel/instances/qemu-demo/status 2>/dev/null || true)
	cpu2_online=$(cat /sys/devices/system/cpu/cpu2/online 2>/dev/null || true)
	printf 'MK_SECONDARY_TIMEOUT_DIAG id=1 status=%s cpu2_online=%s\n' \
		"$secondary_status" "$cpu2_online"
	dmesg | tail -n 80
	fail secondary-marker
fi

printf 'MK_PRIMARY_STILL_ALIVE instance=0 after=MK_SECONDARY_ALIVE\n'
pf_driver=$(driver_name "$pf_path")
[ "$pf_driver" = igb ] || fail pf-driver-lost
vf_driver=$(driver_name "$vf_path")
[ "$vf_driver" = multikernel-pci-assignment ] || fail vf-lease-lost
[ "$(cat "$pf_path/sriov_numvfs")" = 1 ] || fail vf-count-changed
/bin/busybox ip link show "$pf_netdev" | grep -q 'UP' || fail pf-link-lost
printf 'MK_STAGE_PF_ACTIVE pf=%s driver=igb netdev=%s vfs=1\n' "$pf_bdf" "$pf_netdev"
hostile_lease_attempts active
kerf kill qemu-demo || fail kerf-kill
printf 'MK_STAGE_KERF_KILL_OK id=1\n'
expect_status qemu-demo 1 loaded || fail status-after-kill
vf_driver=$(driver_name "$vf_path")
[ "$vf_driver" = multikernel-pci-assignment ] || fail vf-lease-released-on-kill
printf 'MK_HOSTILE_LEASE_PERSISTED phase=after-kill vf=%s owner=multikernel-pci-assignment\n' "$vf_bdf"
kerf unload qemu-demo || fail kerf-unload
printf 'MK_STAGE_KERF_UNLOAD_OK id=1\n'
expect_status qemu-demo 1 ready || fail status-after-unload
vf_driver=$(driver_name "$vf_path")
[ "$vf_driver" = multikernel-pci-assignment ] || fail vf-lease-released-on-unload
printf 'MK_HOSTILE_LEASE_PERSISTED phase=after-unload vf=%s owner=multikernel-pci-assignment\n' "$vf_bdf"
exec 3>&-
kerf delete qemu-demo || fail kerf-delete
printf 'MK_STAGE_KERF_DELETE_OK id=1\n'
[ ! -e /sys/fs/multikernel/instances/qemu-demo ] || fail instance-not-deleted
wait_vf_owner "$vf_host_driver" || fail vf-host-driver-not-restored
assert_pf_owned cycle-1
printf 'MK_STAGE_VF_RESTORED phase=cycle-1 vf=%s driver=%s pf=%s pf_driver=igb\n' \
	"$vf_bdf" "$vf_host_driver" "$pf_bdf"

for cycle in 2 3 4; do
	instance_name=qemu-repeat-$cycle
	kerf create "$instance_name" --id="$cycle" --cpus=2 --memory=256MB \
		--memory-base="$pool_base" --devices=igbvf0 \
		|| fail "repeat-create-$cycle"
	expect_status "$instance_name" "$cycle" ready \
		|| fail "repeat-status-$cycle"
	assert_vf_owner multikernel-pci-assignment "repeat-$cycle"
	dmesg | grep -Fq "Attached $vf_bdf to host-owned IOMMU domain for instance $cycle" \
		|| fail "repeat-iommu-$cycle"
	printf 'MK_REPEAT_VF_LEASED cycle=%s vf=%s group=%s\n' \
		"$cycle" "$vf_bdf" "$vf_group"
	kerf delete "$instance_name" || fail "repeat-delete-$cycle"
	[ ! -e "/sys/fs/multikernel/instances/$instance_name" ] \
		|| fail "repeat-instance-$cycle"
	wait_vf_owner "$vf_host_driver" || fail "repeat-restore-$cycle"
	assert_pf_owned "repeat-restore-$cycle"
	printf 'MK_REPEAT_CYCLE_PASS cycle=%s vf=%s restoration=verified\n' \
		"$cycle" "$vf_bdf"
done

kerf create hostile-unbind --id=104 --cpus=2 --memory=256MB \
	--memory-base="$pool_base" --devices=igbvf0 || fail hostile-unbind-create
expect_status hostile-unbind 104 ready || fail hostile-unbind-ready
assert_vf_owner multikernel-pci-assignment hostile-unbind-ready
printf '%s\n' "$vf_bdf" \
	>/sys/bus/pci/drivers/multikernel-pci-assignment/unbind \
	|| fail hostile-unbind-write
expect_status hostile-unbind 104 failed || fail hostile-unbind-not-failed
vf_driver=$(driver_name "$vf_path")
[ -z "$vf_driver" ] || fail hostile-unbind-driver-present
dmesg | grep -Fq "PCI assignment lease for $vf_bdf was lost by instance 104" \
	|| fail hostile-unbind-no-lease-loss
assert_pf_owned hostile-unbind-failed
printf 'MK_HOSTILE_SURPRISE_UNBIND_FAIL_CLOSED id=104 vf=%s state=failed vf_driver=unbound pf_driver=igb\n' \
	"$vf_bdf"
kerf delete hostile-unbind || fail hostile-unbind-delete
wait_vf_owner "$vf_host_driver" || fail hostile-unbind-restore
assert_pf_owned hostile-unbind-restored
printf 'MK_HOSTILE_SURPRISE_UNBIND_RECOVERED id=104 vf=%s driver=%s\n' \
	"$vf_bdf" "$vf_host_driver"

printf '0\n' >"$pf_path/sriov_numvfs" || fail vf-teardown
printf 'MK_STAGE_VF_TEARDOWN pf=%s vfs=0\n' "$pf_bdf"
printf 'MK_DEMO_PASS simultaneous_kernels=verified iommu=verified vf_lease=verified hostile_attempts=verified repeat_cycles=3 fail_closed=verified\n'
sync
poweroff -f
while :; do sleep 1; done
