/dts-v1/;

/ {
	compatible = "multikernel-v1";
	resources {
		cpus = <2>;
		memory-base = <0x40000000>;
		memory-bytes = <0x20000000>;
		pci-host-bridges {
			host@0000,00 {
				segment = <0>;
				bus-range = <0 255>;
				ecam-base = /bits/ 64 <0xb0000000>;
			};
		};
		devices {
			igbvf0 {
				device-type = "pci";
				compatible = "intel,igbvf";
				pci-id = "@VF_BDF@";
				vendor-id = <0x@VF_VENDOR@>;
				device-id = <0x@VF_DEVICE@>;
			};
		};
	};
};
